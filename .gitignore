# Root .gitignore for Reel Knowledge Base (Mindmap)

# Dependencies
node_modules/
*/node_modules/

# Environment files & secrets
.env
.env.*
.env.local
!.env.example
!.env.local.example
*/.env
*/.env.*
*/.env.local
!*/.env.example
!*/.env.local.example

# Next.js & Frontend builds
*/.next/
*/out/
*/build/
.vercel/
*/.vercel/

# NestJS Backend builds & storage
*/dist/
*/storage/
*/tmp/
*/temp/
node_modules/.prisma/

# TypeScript cache
*.tsbuildinfo
*/tsconfig.tsbuildinfo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS & Editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
