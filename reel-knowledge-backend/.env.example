# ==============================================================================
# Reel Knowledge Backend — Environment Configuration Example
# ==============================================================================
# Copy this file to .env and replace the placeholder values with your own:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database & Cache
# ------------------------------------------------------------------------------
# PostgreSQL database connection string (requires pgvector extension enabled)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reelkb"

# Redis configuration (used by BullMQ queue for async processing)
REDIS_HOST=localhost
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 2. AI Services (Embeddings, LLM, Speech-to-Text)
# ------------------------------------------------------------------------------
# Local Ollama URL (used for nomic-embed-text 768-dim vector embeddings)
OLLAMA_URL=http://localhost:11434

# Groq API Key (used for Whisper transcription, LLM summary & taxonomy categorization)
# Get your API key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Groq LLM Model ID for item enrichment and categorization
# Recommended: openai/gpt-oss-20b, llama-3.1-8b-instant, or qwen/qwen3.6-27b
GROQ_MODEL=openai/gpt-oss-20b

# Semantic search maximum cosine distance threshold (lower = stricter match)
SEARCH_MAX_DISTANCE=0.65

# ------------------------------------------------------------------------------
# 3. Media Processing Tools
# ------------------------------------------------------------------------------
# Path to yt-dlp binary (if installed globally in PATH, simply "yt-dlp", otherwise full path)
YT_DLP_PATH=yt-dlp

# Path to ffmpeg binary (if installed globally in PATH, simply "ffmpeg", otherwise full path)
FFMPEG_PATH=ffmpeg

# ------------------------------------------------------------------------------
# 4. Server Configuration
# ------------------------------------------------------------------------------
# Port for the NestJS REST API
PORT=3000

# ------------------------------------------------------------------------------
# 5. Telegram Bot (Optional / Fallback Channel)
# ------------------------------------------------------------------------------
# Telegram Bot API token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather

# ------------------------------------------------------------------------------
# 6. Instagram & Meta Graph API Integration
# ------------------------------------------------------------------------------
# Meta App credentials from https://developers.facebook.com
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret

# Custom random token string used to verify webhook subscription with Meta
META_WEBHOOK_VERIFY_TOKEN=your_custom_secure_verify_token

# Instagram Bot Account (Creator / Professional account used for webhook capture)
IG_BOT_ACCOUNT_ID=your_ig_bot_account_id
IG_BOT_ACCESS_TOKEN=your_ig_bot_long_lived_access_token

# Instagram Personal Account (Creator / Professional account sharing links)
IG_PERSONAL_ACCOUNT_ID=your_ig_personal_account_id
IG_PERSONAL_ACCESS_TOKEN=your_ig_personal_long_lived_access_token

# Access control: Comma-separated Instagram Scoped IDs (IGSIDs) allowed to trigger extraction
ALLOWED_IG_SENDER_IDS=your_personal_igsid_here

# Instagram Scoped ID (IGSID) to receive completion notifications when processing finishes
IG_NOTIFY_IGSID=your_personal_igsid_here
